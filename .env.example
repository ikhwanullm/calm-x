# Calm-X environment variables — copy to .env and adjust.
# .env is gitignored; .env.example is committed as a safe reference.

# Port the backend listens on (default: 8080)
# CALM_X_PORT=8080

# Vite dev server origins allowed by CSRF middleware (comma-separated)
CALM_X_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
